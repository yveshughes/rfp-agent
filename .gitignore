# Publish only the reviewed site and deployment files.
/*
!/.gitignore
!/README.md
!/LICENSE
!/site/
!/deploy/
!/app/
!/tests/

# Never publish credentials, local state, or editor files.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/node_modules/
**/__pycache__/

# Proprietary RFP source directory: keep local and deployed copies private.
# Match at any depth, including inside otherwise publishable directories.
**/rfpsonar-found-rfp-sources*.json
**/rfp-sources*.json
**/rfp-source-directory*.json
